# /etc/zeromq-server/zeromq-server.env
# Bind on all interfaces so remote clients can connect (CURVE protects the link)
ZMQ_ENDPOINT=tcp://*:5555
ZMQ_CURVE=1
ZMQ_CERT_DIR=/etc/zeromq-server/certs
# Optional additional IP whitelist (comma separated)
#ZMQ_ALLOW_IP=192.168.1.10,192.168.1.11
ZMQ_LOG_LEVEL=INFO
